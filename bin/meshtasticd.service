[Unit]
Description=Meshtastic %i Daemon
# Ordering only: a missing avahi-daemon.service must not block startup.
After=network-online.target bluetooth.service avahi-daemon.service
Wants=bluetooth.service
StartLimitInterval=200
StartLimitBurst=5

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
User=meshtasticd
Group=meshtasticd
Type=simple
ExecStart=/usr/bin/meshtasticd-start.sh %i
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
